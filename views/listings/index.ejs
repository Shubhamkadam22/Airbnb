<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>
<body>
    <h3>Welcome to Wanderlust</h3>
    <ul>
    <% for (let listing of allListings) { %>
        <li>
            <h6><%= listing.title %></h6>
            <p><%= listing.description %></p>
            <p>Price: $<%= listing.price %></p>
        </li>
    <% } %>
</ul>
</body>
</html>
