<% layout('/layouts/boilerplate') %>
<body>
    <br>
    <h2>Welcome to Wanderlust</h2><br>
    <p>Discover your next adventure with our curated listings of unique stays and experiences around the</p>
    <br>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
<% for (let listing of allListings) { %>
  <a href="/listings/<%= listing._id %>" class="listing-link">
<div class="card col listing-card border-0 shadow-sm h-100">
  <img 
  src="<%= listing.image.url %>" 
  class="card-img-top rounded-4" 
  alt="listing image" 
  style="height: 20rem; object-fit: cover;">
  <div class="card-img-overlay"></div>
  <div class="card-body px-0 pt-2">
    <p class="card-text">
        <strong><%= listing.title %></strong> <br>
        &#8377; <%= (listing.price || 0).toLocaleString("en-IN") %> / night
    </p>
  </div>
</div>
  </a> 
<br>  
 <% } %>
</div>
</body>