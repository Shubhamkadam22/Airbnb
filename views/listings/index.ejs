<% layout('/layouts/boilerplate') %>
<body>
    <br>
    <h2>Welcome to Wanderlust</h2><br>
    <p>Discover your next adventure with our curated listings of unique stays and experiences around the
<br>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
<% for (let listing of allListings) { %>
  <a href="/listings/<%= listing._id %>" class="listing-links">
<div class="card col">
  <img 
  src="<%= listing.image.url %>" 
  class="card-img-top" 
  alt="listing image" 
  style="height: 20rem;">
  <div class="card-img-overlay">50% OFF</div>
  <div class="card-body">
    <p class="card-text">
        <strong><%= listing.title %></strong> <br>
        &#8377 <%= listing.price.toLocaleString("en-IN") %> / night
    </p>
    
  </div>
</div>
  </a> 
 <% } %>
</div>
</body>

