<% layout('/layouts/boilerplate') %>
<body>
    <h3>Create a New Listing: </h3>
    <form action="/listings" method="POST">
       
        <input name="listing[title]" type="text" id="title" ><br><br>

        <input name="listing[link]" type="text" id="link" placeholder="Enter a link to the image" ><br><br  >
        
        <textarea name="listing[description]" id="description" type="text" ></textarea>
        <br> <br>        
        <input name="listing[price]" type="number" id="price" >
        <br> <br>
        <input name="listing[country]" type="text" id="country" required><br><br>

       
        <input name="listing[location]" type="text" id="location" >
        <br> <br>        

        
        <br>
       <br> <br>
        <button type="submit">Create Listing</button>
</body>
